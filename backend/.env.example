# =============================================================================
# .env de desarrollo local (backend lee este archivo con django-environ).
# Postgres dockerizado local: docker compose up -d db  (puerto host 5434)
# =============================================================================
SECRET_KEY=django-insecure-pariwana-scheduler-dev-key-12345
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1
# Puerto 5432 directo (sin PgBouncer). NO usar ?pgbouncer=true (psycopg 3 no lo soporta)
DATABASE_URL=postgresql://pariwana:pariwana_dev_password@localhost:5434/pariwana_buk
TIME_ZONE=America/Lima
BUK_EXPORT_DEFAULT_FORMAT=xlsx
BUK_DEFAULT_SHEET_NAME=Reporte carga BUK
