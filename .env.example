# =============================================================================
# Template .env de producción (se carga como secreto DEPLOY_ENV_FILE en GitHub
# Actions y se copia al servidor en /home/ubuntu/schedules/.env)
# =============================================================================
SECRET_KEY=
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=.tudominio.com,localhost
CSRF_TRUSTED_ORIGINS=https://.tudominio.com,https://localhost

# -----------------------------------------------------------------------------
# PostgreSQL dockerizado (servicio "db" de docker-compose.prod.yml)
# DATABASE_URL y DB_* deben apuntar a la MISMA base (host "db" dentro de la red
# interna del compose). No usar ?pgbouncer=true (psycopg 3 no lo soporta).
# -----------------------------------------------------------------------------
DB_NAME=pariwana_buk
DB_USER=pariwana
DB_PASSWORD=<generar-clave-fuerte>
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://pariwana:<generar-clave-fuerte>@db:5432/pariwana_buk

TIME_ZONE=America/Lima
BUK_EXPORT_DEFAULT_FORMAT=xlsx
BUK_DEFAULT_SHEET_NAME=Reporte carga BUK
